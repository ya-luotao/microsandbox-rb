# frozen_string_literal: true

require "fileutils"
require "open-uri"
require "tmpdir"

require_relative "lib/microsandbox_rb_binaries"
require_relative "lib/microsandbox_rb_binaries/vendor_tools"

# The prototype targets the host platform only; the release asset naming
# mirrors the core crate's `bundle_download_url` (darwin/aarch64 → the
# `microsandbox-darwin-aarch64.tar.gz` bundle).
RUNTIME_VERSION = MicrosandboxRbBinaries::RUNTIME_VERSION
BUNDLE_ASSET = "microsandbox-darwin-aarch64.tar.gz"
CHECKSUMS_ASSET = "checksums.sha256"
# The releases/download/ endpoint is unauthenticated and not rate-limited
# (unlike the api.github.com release API).
RELEASE_BASE = "https://github.com/superradcompany/microsandbox/releases/download/#{RUNTIME_VERSION}"

VENDOR_DIR = File.expand_path("vendor", __dir__)

def fetch(url)
  URI.parse(url).open("rb", &:read) # open-uri follows the S3 redirect
end

desc "Download the #{RUNTIME_VERSION} runtime bundle, verify its sha256 " \
  "against the release's #{CHECKSUMS_ASSET}, stage + validate it in a fresh " \
  "sibling dir, and atomically promote it to vendor/ (with a sha256 manifest " \
  "the gem build revalidates)"
task :vendor do
  tools = MicrosandboxRbBinaries::VendorTools

  tools.with_packaging_lock(__dir__) do
    # Recover an orphaned backup from a crashed promotion BEFORE cleaning
    # anything; stale staging trees are then discarded (never resume points).
    tools.recover_orphans!(VENDOR_DIR)

    checksums = fetch("#{RELEASE_BASE}/#{CHECKSUMS_ASSET}")
    expected = tools.expected_sha256!(checksums, BUNDLE_ASSET)
    data = fetch("#{RELEASE_BASE}/#{BUNDLE_ASSET}")
    actual = tools.verify_sha256!(data, expected, BUNDLE_ASSET)
    puts "verified #{BUNDLE_ASSET} (#{data.bytesize} bytes, sha256 #{actual})"

    staging = "#{VENDOR_DIR}.staging-#{Process.pid}"
    begin
      Dir.mktmpdir do |tmp|
        tarball = File.join(tmp, BUNDLE_ASSET)
        File.binwrite(tarball, data)
        tools.stage_bundle!(tarball, staging)
      end
      tools.validate_staged!(staging, RUNTIME_VERSION)
      tools.write_manifest!(staging, runtime_version: RUNTIME_VERSION, bundle_sha256: actual)
      tools.promote!(staging, VENDOR_DIR)
    rescue
      # Fail-closed: a failed run never leaves a staging tree behind, and the
      # previous vendor tree (if any) is only replaced by the atomic promote.
      FileUtils.rm_rf(staging)
      raise
    end
    puts "staged: #{tools.verify_manifest!(VENDOR_DIR, expected_runtime_version: RUNTIME_VERSION).join(", ")}"
  end
end

namespace :build do
  desc "Build the arm64-darwin platform gem (requires rake vendor first; " \
    "runs under the packaging lock, revalidates vendor/manifest.sha256 " \
    "fail-closed, and re-verifies the finished gem's payload)"
  task :platform do
    tools = MicrosandboxRbBinaries::VendorTools
    tools.with_packaging_lock(__dir__) do
      sh({"MSB_BINARIES_PLATFORM" => "arm64-darwin"}, "gem build microsandbox-rb-binaries.gemspec")
      gem_file = File.join(__dir__, "microsandbox-rb-binaries-#{MicrosandboxRbBinaries::VERSION}-arm64-darwin.gem")
      begin
        tools.verify_gem_payload!(gem_file, expected_runtime_version: RUNTIME_VERSION)
        puts "gem payload verified against its packaged manifest"
      rescue
        # Never leave an artifact that failed its own payload verification.
        FileUtils.rm_f(gem_file)
        raise
      end
    end
  end

  desc "Build the empty ruby-platform fallback gem (the gemspec default)"
  task :ruby do
    sh({"MSB_BINARIES_PLATFORM" => "ruby"}, "gem build microsandbox-rb-binaries.gemspec")
  end
end

desc "Build both variants"
task build: ["build:platform", "build:ruby"]
